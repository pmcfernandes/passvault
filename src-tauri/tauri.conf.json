{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassVault",
  "version": "1.1.1",
  "identifier": "com.passvault.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "PassVault",
        "width": 1120,
        "height": 760,
        "minWidth": 390,
        "minHeight": 620,
        "backgroundColor": "#0a0e1a",
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "../build/app-icon.ico",
      "../build/app-icon.png"
    ],
    "targets": "all"
  }
}
